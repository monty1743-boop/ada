+_ADA_WAKE_RE = re.compile(
+    r"^(?:(?:hey|hi|ok|okay|yo)\b[\s,]*)?ada\b[\s,!.?:;\-]*",
+    re.IGNORECASE,
+)
+
+
+def _ada_wake_command(transcript: str) -> str | None:
+    """Return the request after a leading Ada, or None when she was not called."""
+    spoken = (transcript or "").strip()
+    match = _ADA_WAKE_RE.match(spoken)
+    if not match:
+        return None
+    rest = spoken[match.end():].strip(" \t,.:;-")
+    return rest or "Ada"
+
